# Copy to .env and fill in. Never commit the filled-in file.

# Supabase project URL, e.g. https://your-project.supabase.co
SUPABASE_URL=

# Service role key, from Project Settings -> API in the Supabase dashboard.
# This bypasses Row Level Security, so it is server-side only. Do not put it
# in any client bundle and do not expose it through a browser-reachable route.
SUPABASE_SERVICE_ROLE_KEY=

# Port the local dev server binds to. Optional, defaults to 3001.
PORT=3001

# Rate limiting (optional). Without both of these set, rate limiting is a
# no-op: every request passes through unlimited. Set both to enforce 100
# requests/minute/IP, backed by Upstash Redis rather than process memory.
# From the Upstash console -> Redis database -> REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
